  "private": true,
  "main": "index.html",
  "scripts": {
    "start": "python3 -m http.server 8765",
    "build": "node build.mjs",
    "build:www": "node build.mjs",
    "build:vendor": "node build.mjs vendor",
    "test:core": "node test_core.js",
    "test:dom": "node test_dom.mjs",
    "test:daliuren": "node test-daliuren.js",
    "test:ziwei": "node test-ziwei-bazi.js",
    "test": "node test_core.js && node test-daliuren.js && node test-ziwei-bazi.js && node test_dom.mjs",
