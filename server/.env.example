# 玄决云后端 · 环境变量（复制为 .env 并填值）
# 生成 JWT_SECRET：openssl rand -base64 48
JWT_SECRET=
PORT=8787
LOG_LEVEL=info
DATABASE_URL=postgres://xuanjue:xuanjue@127.0.0.1:5432/xuanjue

# token 有效期
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# 允许的跨域来源（逗号分隔）；Capacitor 原生 App 为 https://localhost
CORS_ORIGINS=https://localhost,http://localhost:8765,https://your-domain.com

# true/false —— 压测或私有部署时可关闭注册
ALLOW_SIGNUP=true

# ---------- AI 云代理（站长提供 Key，用户端免 Key） ----------
# 开启后：客户端未配 Key 也能用，请求经服务端转发；Key 加密落库，接口不返回明文。
# 关闭则为「用户自带 Key 直连厂商」的老行为，与之前完全一致。
AI_PROXY_ENABLED=false

# Key 加密主密钥，32 字节。生成：openssl rand -base64 32
# 只存在于服务端环境变量：不落库、不打日志、不进任何接口响应。
# 换了它，已存的 Key 密文全部作废（ai_key_unreadable），需重新配置。
AI_KEY_MASTER=

# 每个用户每天的提问上限（打爆余额的最终保险），默认 30
AI_DAILY_LIMIT=30

# 每个用户每分钟的提问上限（防突发刷接口），默认 6
AI_RATE_PER_MINUTE=6

# 站长内置 Key（可选）：配了它，用户端就真正「零配置」——不用人人自己申请 Key。
# 格式：protocol://key@base-url/model，例如：
#   AI_SITE_KEY=openai://sk-xxx@https://api.deepseek.com/v1/deepseek-chat
#  anthropic 协议同理：
#   AI_SITE_KEY=anthropic://sk-ant-xxx@https://api.anthropic.com/v1/claude-sonnet-4-5
# 多把 Key 用 | 分隔，自动轮询分摊压力：
#   AI_SITE_KEY=openai://sk-a@https://api.deepseek.com/v1/deepseek-chat|openai://sk-b@https://api.deepseek.com/v1/deepseek-chat
# 安全说明：只活在进程内存，不落库、不打日志、不进任何接口响应；改了要重启进程才生效。
# 空着则走「用户自带 Key」的老路（Key 加密落库）。
AI_SITE_KEY=
